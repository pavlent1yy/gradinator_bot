# --- Обязательно ---
BOT_TOKEN=

# --- G-API ---
# Если G-API на другом сервере — укажи его адрес.
# Если на этом же хосте:
API_BASE_URL=http://host.docker.internal:9090

# --- База (путь внутри контейнера, не менять) ---
DB_PATH=/app/data/gradinator_bot.sqlite3

# --- Прокси до Telegram ---
# Значение уже задано в docker-compose.yml. Если прокси на другом порту/адресе — поменять там. 
# Оставь эту строку пустой, чтобы ходить напрямую:
# PROXY=


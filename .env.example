# --- Обязательно ---
BOT_TOKEN=

# --- G-API ---
# Публичный экземпляр:
API_BASE_URL=https://gradinator.itsyoraaa.su
# Локально: http://localhost:9090
# В Docker (network_mode: host) G-API на этом же хосте тоже доступен как http://localhost:9090

# --- База ---
# Локально:
DB_PATH=./gradinator_bot.sqlite3
# В Docker (не менять, том bot_data смонтирован в /app/data):
# DB_PATH=/app/data/gradinator_bot.sqlite3

# --- Прокси до Telegram (опционально) ---
# Пусто — ходить напрямую. Пример: socks5://127.0.0.1:10808
PROXY=
